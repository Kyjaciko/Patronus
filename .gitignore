# Build output
/build/
/out/
bin/
obj/

# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
CMakeUserPresets.json

# Fetched dependencies (re-downloaded by CMake on every clean configure --
# see FETCHCONTENT_BASE_DIR in CMakeLists.txt)
/external/*
!/external/.gitkeep

# Visual Studio / MSVC
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
ipch/
*.ilk
*.pdb
*.obj
*.exp
*.lib
*.log
*.tlog

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Python tooling (tools/)
__pycache__/
*.pyc
.venv/
venv/

# Benchmark runs: raw CSVs are per-machine measurements, not source.
# Commit only the summarised tables/plots you want in the README.
/benchmarks/runs/

# Misc
*.tmp
*.bak
Thumbs.db
Desktop.ini
